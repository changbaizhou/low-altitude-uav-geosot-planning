# Copy this file to .env and edit local values before running the project.
# The helper scripts and backend tools load the repository-root .env automatically.

# Backend
PORT=3000
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgresql_password
PGDATABASE=uav-db

# Optional weather control. Leave blank to disable real weather sync.
QWEATHER_API_KEY=
QWEATHER_API_HOST=https://devapi.qweather.com
QWEATHER_LOCATION=118.78,31.92

# Frontend
VITE_API_BASE=http://localhost:3000
VITE_CESIUM_ION_TOKEN=
